DB_URL=jdbc:postgresql://localhost:5432/consulta_ciudadano
DB_USER=consulta
DB_PASSWORD=consulta_local
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Secreto aleatorio de al menos 32 caracteres. No reutilizar el valor de pruebas.
JWT_SECRET=
JWT_SHORT_TTL=PT15M
JWT_REMEMBER_TTL=PT8H
ADMIN_INITIAL_IDENTIFICACION=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# SMTP de pruebas (Mailpit por defecto).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@localhost
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
